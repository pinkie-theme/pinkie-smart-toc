{
  "manifest_version": 3,
  "name": "Pinkie Smart TOC for AI Chats",
  "version": "1.0.0",
  "description": "🌸 A gorgeous and smart Table of Contents sidebar with real-time text-highlight saver for ChatGPT, Gemini, Grok, and Claude. Built for developers and AI lovers!",
  "homepage_url": "https://github.com/justduyen/pinkie-smart-toc",
  "author": "JustDuyen",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Pinkie Smart TOC"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://grok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
